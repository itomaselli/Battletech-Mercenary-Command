config_version=5

[application]
config/name="BattleTech • Mercenary Command"
config/version="0.46.0"
run/main_scene="res://ui/main.tscn"

[display]
window/size/viewport_width=1672
window/size/viewport_height=940
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.075, 0.09, 1)
textures/default_filters/use_nearest_mipmap_filter=false
