extends SceneTree
const Campaign = preload("res://sim/campaign.gd")
const Operations = preload("res://sim/operations.gd")
var checks = 0
var failures = 0
func check(ok: bool, message: String):
	checks += 1
	if not ok:
		failures += 1
		printerr("FAIL Phase III: ", message)
func fixture(path: String, value):
	var file = FileAccess.open(path, FileAccess.WRITE)
	file.store_string(JSON.stringify(value))
func deployed(approach = "direct", authority = "delegate", priority = "objective", seed_value = 3027):
	var c = Campaign.new(seed_value)
	c.configure_operation(approach, authority, priority)
	c.accept_contract(0)
	c.dispatch(0, [0, 1, 2, 3], 1)
	return c
func _initialize():
	var c = deployed("recon", "consult")
	check(c.state.active.remaining == 4 and c.state.supplies == 46, "recon time and supplies charged at deployment")
	var combat_rng = c.rng.state
	var before = c.state.duplicate(true)
	c.configure_operation("direct", "delegate", "objective")
	check(c.state == before, "cannot rewrite launched preparation")
	c.advance(7)
	check(c.state.day == 2 and c.military_waiting(), "consult stops multiday calendar at contact")
	check(c.rng.state == combat_rng, "friction does not consume combat dice")
	before = c.state.duplicate(true)
	c.advance(7)
	check(c.state == before, "pending decision freezes world and costs")
	c.decide_operation("invalid")
	check(c.state == before, "unknown decision rejected atomically")
	check(c.save_game("user://phase3_pending.json") == OK, "save pending consultation")
	var loaded = Campaign.new()
	check(loaded.load_game("user://phase3_pending.json") == OK and loaded.state == c.state, "restore pending consultation")
	var remaining = c.state.active.remaining
	c.decide_operation("maneuver")
	loaded.decide_operation("maneuver")
	check(c.state.supplies == 42 and c.state.active.remaining == remaining + 1, "maneuver costs four supplies and one day")
	before = c.state.duplicate(true)
	c.decide_operation("maneuver")
	check(c.state == before, "no repeat decision bonuses")
	c.advance(10)
	loaded.advance(10)
	check(c.state == loaded.state and c.state.active.is_empty(), "loaded operation has identical outcome")
	check(c.state.military.archive.size() == 1 and c.state.military.archive[0].losses.size() == 4, "after action report records own force damage")
	check(Operations.valid(c.state.military, c.state.day, c.state.active), "completed archive validates")
	var public = JSON.stringify(c.operation_report())
	check(not public.contains("severity") and not public.contains("obstacle") and not public.contains("bonus") and not public.contains("private"), "archive public report excludes hidden factors")
	var orders = deployed()
	orders.send_operation_order("consult", "preserve")
	check(orders.state.military.current.orders.authority == "delegate", "transmitted orders do not apply instantly")
	before = orders.state.duplicate(true)
	orders.send_operation_order("delegate", "objective")
	check(orders.state == before, "only one order in transit")
	check(orders.save_game("user://phase3_order.json") == OK, "save transmitted orders")
	var transit = Campaign.new()
	check(transit.load_game("user://phase3_order.json") == OK, "load transmitted orders")
	orders.advance(1)
	transit.advance(1)
	check(orders.state == transit.state and orders.state.military.current.orders.authority == "consult", "order received on next day and preserved across load")
	orders.advance(7)
	check(orders.military_waiting(), "received delegation policy changes next contact")
	var retreat_hp = orders.state.mechs[0].hp
	orders.decide_operation("withdraw")
	check(orders.state.active.is_empty() and orders.state.military.current.is_empty(), "withdrawal clears both operation states")
	check(orders.state.mechs[0].hp == retreat_hp - 3 and orders.state.military.archive[0].outcome.contains("Retirada"), "contact extraction costs damage and is archived")
	before = orders.state.duplicate(true)
	orders.decide_operation("withdraw")
	check(orders.state == before, "withdrawal cannot be applied twice")
	var auto_retreat = Campaign.new()
	auto_retreat.configure_operation("direct", "delegate", "preserve")
	for mech in auto_retreat.state.mechs: mech.hp = 60
	auto_retreat.accept_contract(0)
	auto_retreat.dispatch(0, [0, 1, 2, 3], 1)
	auto_retreat.advance(2)
	check(auto_retreat.state.active.is_empty() and auto_retreat.state.military.archive[0].outcome.contains("Retirada"), "subordinate follows explicit preservation threshold")
	check(auto_retreat.state.relationships["Liga comercial"] == -2, "autonomous retreat has contractual consequences")
	var protect = deployed("direct", "delegate", "preserve")
	protect.advance(2)
	check(protect.state.military.current.response == "maneuver" and protect.state.supplies == 46, "delegated preservation chooses funded maneuver")
	var poor = deployed("direct", "consult")
	poor.advance(2)
	poor.state.supplies = 0
	before = poor.state.duplicate(true)
	poor.decide_operation("maneuver")
	check(poor.state == before, "unfunded maneuver is atomic")
	poor.decide_operation("press")
	check(not poor.military_waiting(), "free continue remains available")
	var early = deployed()
	early.cancel_contract()
	check(early.state.mechs[0].hp == 100 and early.state.military.archive.size() == 1, "precontact withdrawal does not invent damage")
	var invalid = Campaign.new()
	before = invalid.state.duplicate(true)
	invalid.configure_operation("secret", "consult", "preserve")
	check(invalid.state == before, "invalid order plan rejected")
	var legacy_source = deployed()
	var legacy = legacy_source.state.duplicate(true)
	legacy.version = 16
	legacy.erase("military")
	legacy.rng_state = str(legacy_source.rng.state)
	fixture("user://phase3_legacy.json", legacy)
	var migrated = Campaign.new()
	check(migrated.load_game("user://phase3_legacy.json") == OK, "migrate v0.8 in-flight operation")
	check(migrated.state.active == legacy.active and migrated.state.chronicle == legacy.chronicle and migrated.state.military.current.is_empty(), "migration preserves legacy orders and history")
	migrated.advance(3)
	check(migrated.state.active.is_empty() and migrated.state.military.archive.is_empty(), "legacy operation resolves without retroactive new stages")
	var bad = protect.state.duplicate(true)
	bad.rng_state = str(protect.rng.state)
	bad.military.current.private.severity = 99
	fixture("user://phase3_bad.json", bad)
	before = protect.state.duplicate(true)
	check(protect.load_game("user://phase3_bad.json") == ERR_INVALID_DATA and protect.state == before, "invalid operational state rejected atomically")
	var weak = deployed("direct", "consult", "objective", 55)
	var skilled = deployed("direct", "consult", "objective", 55)
	weak.person_by_id(weak.state.active.leader).skill = 0
	skilled.person_by_id(skilled.state.active.leader).skill = 5
	weak.advance(2)
	skilled.advance(2)
	weak.state.military.current.private.severity = 2
	skilled.state.military.current.private.severity = 2
	weak.decide_operation("press")
	skilled.decide_operation("press")
	check(skilled.state.military.current.private.damage < weak.state.military.current.private.damage, "leader experience mitigates operational friction")
	for seed_value in range(20):
		var run = deployed("recon" if seed_value % 2 else "direct", "consult" if seed_value % 3 else "delegate", "preserve" if seed_value % 2 else "objective", seed_value)
		for step in range(12):
			if run.military_waiting(): run.decide_operation("maneuver" if seed_value % 2 else "press")
			run.advance(1)
			check(Operations.valid(run.state.military, run.state.day, run.state.active), "valid operational state seed %d step %d" % [seed_value, step])
		check(run.state.active.is_empty() and run.state.military.archive.size() == 1, "operation reaches final outcome seed %d" % seed_value)
	print("Phase III: %d checks, %d failures" % [checks, failures])
	quit(1 if failures else 0)
