extends SceneTree
const C = preload("res://sim/campaign.gd")
func _initialize():
 for decision in ["people","material","both","withdraw"]:
  var sim = C.new(821)
  assert(sim.rpg_command("configure",{"origin":"tecnico","specialty":"investigacion","motivation":"proteccion","bond":4}).contains("establecido"))
  assert(sim.state.rpg.captain.skills.investigacion==4)
  sim.rpg_command("start_cargo")
  assert(sim.state.rpg.scene=="briefing")
  var cash = sim.state.funds
  sim.rpg_command("start_cargo")
  assert(cash==sim.state.funds)
  sim.advance(1)
  assert(sim.state.day==0)
  sim.rpg_command("choose",{"choice":"questions"})
  if decision=="both":
   sim.rpg_command("prepare",{"approach":"transport"})
   assert(sim.dispatch(0,[0,1,2,3],1).contains("capitán"))
   sim.advance(1)
   assert(sim.state.rpg.cargo.extra)
  assert(sim.dispatch(0,[0,1,2,3],1).contains("autorizado"))
  sim.advance(3)
  assert(sim.state.rpg.scene=="discovery")
  assert(sim.save_game("user://rpg16.json")==OK)
  var restored = C.new()
  assert(restored.load_game("user://rpg16.json")==OK)
  assert(restored.state==sim.state)
  var frozen = sim.state.day
  sim.advance(1)
  assert(sim.state.day==frozen)
  for game in [sim,restored]:
   game.rpg_command("choose",{"choice":decision})
   game.advance(20)
   assert(game.state.rpg.scene=="debrief")
   game.rpg_command("choose",{"choice":"listen"})
   assert(game.state.rpg.cargo.stage=="closed")
   var before=game.state.duplicate(true)
   game.rpg_command("choose",{"choice":"listen"})
   assert(game.state==before)
  assert(sim.state==restored.state)
  assert(sim.save_game("user://rpg16-closed.json")==OK)
  assert(C.new().load_game("user://rpg16-closed.json")==OK)
  print("v0.16 desenlace ",decision," OK")
 print("v0.16: cuatro ramas, pausa, preparación, guardado y efectos únicos OK")
 quit()
