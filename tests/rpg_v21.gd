extends SceneTree
const C=preload("res://sim/campaign.gd")
func _initialize():
 var s=C.new(21)
 s.rpg_command("configure",{"origin":"tecnico","specialty":"mando","motivation":"deuda"})
 var uid=s.state.mechs[0].uid
 s.state.rpg.workshop.faults[str(uid)]={"kind":"mobility","temporary_until":0}
 s.state.mechs[0].hp=60
 assert(not s.mech_ready(0))
 s.rpg_command("workshop",{"action":"temporary","uid":uid})
 s.advance(1)
 assert(s.mech_ready(0))
 for i in range(2):s.rpg_command("workshop",{"action":"buy_parts","kind":"mobility"})
 s.rpg_command("workshop",{"action":"full","uid":uid})
 assert(not s.person_available(s.person_by_id(4)))
 assert(s.save_game("user://rpg21.json")==OK)
 var loaded=C.new()
 assert(loaded.load_game("user://rpg21.json")==OK and loaded.state==s.state)
 s.advance(3)
 assert(s.state.mechs[0].hp==100 and s.state.rpg.workshop.faults.is_empty())
 s.rpg_command("workshop",{"action":"reserve","uid":uid})
 assert(not s.mech_ready(0))
 s.rpg_command("workshop",{"action":"reserve","uid":uid})
 s.rpg_command("workshop",{"action":"cannibalize","uid":uid})
 assert(s.state.mechs[0].hp==0 and s.state.rpg.workshop.parts.electronics==1)
 s.rpg_command("workshop",{"action":"cannibalize","uid":uid})
 assert(s.state.rpg.workshop.parts.electronics==1)
 s.state.rpg.negotiation.salvage.append({"id":"test","contract":1,"source":"Prueba","system":s.state.location_id,"status":"rights","kind":"parts","day":int(s.state.day)})
 s.rpg_command("workshop",{"action":"salvage","id":"test"})
 s.advance(2)
 assert(s.state.rpg.negotiation.salvage[0].status=="assessed")
 s.rpg_command("workshop",{"action":"salvage","id":"test"})
 s.advance(2)
 assert(s.state.rpg.negotiation.salvage[0].status=="processed")
 assert(s.state.rpg.workshop.parts.electronics==2)
 print("v0.21: avería, provisional, reparación completa, reserva, canibalización única y salvamento OK")
 quit()
