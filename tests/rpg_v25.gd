extends SceneTree
const C=preload("res://sim/campaign.gd")
func _initialize():
 var s=C.new(25)
 s.rpg_command("configure",{"origin":"mercenario","specialty":"trato","motivation":"deuda"})
 s.rpg_command("arcs",{"action":"choose","kind":"deuda"})
 var initial=s.state.funds
 for i in range(2):s.rpg_command("arcs",{"action":"pay","amount":25000})
 assert(s.state.funds==initial-50000 and s.RPG.Arcs.ready(s))
 s.rpg_command("arcs",{"action":"pay","amount":25000})
 assert(s.state.funds==initial-50000)
 s.rpg_command("arcs",{"action":"close"})
 s.rpg_command("arcs",{"action":"close"})
 assert(s.state.rpg.arcs.completed.size()==1)
 s.rpg_command("arcs",{"action":"retire"})
 s.advance(1)
 assert(s.state.day==0)
 assert(s.save_game("user://rpg25.json")==OK)
 var loaded=C.new()
 assert(loaded.load_game("user://rpg25.json")==OK and loaded.state==s.state)
 s.rpg_command("arcs",{"action":"continue"})
 s.advance(1)
 assert(s.state.day==1)
 var cost=s.ownership_daily()
 s.rpg_command("arcs",{"action":"settings","economy":80,"danger":120,"frequency":28})
 assert(s.ownership_daily()<cost and s.state.rpg.arcs.settings.danger==120 and s.state.rpg.arcs.settings.frequency==28)
 print("v0.25: deuda real, cierre único, retiro/reanudación, ajustes independientes y guardado OK")
 quit()
