extends SceneTree
const Campaign = preload("res://sim/campaign.gd")
var checks = 0
var failures = 0
func check(ok: bool, message: String):
	checks += 1
	if not ok:
		failures += 1
		printerr("FAIL v0.5: ", message)
func write_fixture(path: String, value):
	var file = FileAccess.open(path, FileAccess.WRITE)
	file.store_string(JSON.stringify(value))
	file.close()
func _initialize():
	var c = Campaign.new()
	var public = c.world_report()
	check(public.actors.size() == 7, "seven actors")
	check(public.actors.filter(func(a): return a.kind == "Contratante").size() == 4, "four employers")
	check(public.actors.filter(func(a): return a.kind == "Compañía rival").size() == 3, "three rivals")
	c.state.world.actors[0].private.priority = "SECRET_SENTINEL"
	c.state.world.links.append({"a": "trade_league", "b": "ember_company", "stance": "SECRET_LINK", "source": "hidden", "reported_day": 0, "public": false})
	var visible = JSON.stringify(c.world_report())
	check(not visible.contains("SECRET") and not visible.contains("capacity") and not visible.contains("commitments") and not visible.contains("private"), "public allowlist excludes internal state")
	var report_copy = c.world_report()
	report_copy.actors[0].name = "Changed"
	check(c.state.world.actors[0].name == "Liga comercial", "public reports detached from state")
	var cash = c.state.funds
	var relationships = c.state.relationships.duplicate(true)
	c.establish_contact("trade_league")
	check(c.state.funds == cash - 1000 and c.state.world.actors[0].contact_day == 0, "contact charged and recorded")
	c.establish_contact("trade_league")
	check(c.state.funds == cash - 1000 and c.state.relationships == relationships, "contact cannot farm trust or duplicate fee")
	c.establish_contact("missing")
	check(c.state.funds == cash - 1000, "unknown actor rejected")
	c.state.funds = 0
	var before = c.state.duplicate(true)
	c.establish_contact("grey_lances")
	check(c.state == before, "unaffordable contact is atomic")
	var contracts = Campaign.new()
	check(contracts.state.offers[0].employer_id == "trade_league", "contract identifies employer")
	contracts.accept_contract(0)
	var agreed = contracts.state.accepted.duplicate(true)
	contracts._change_relation("Liga comercial", 3)
	check(contracts.world_report().actors[0].trust == 3, "world trust uses existing employer history")
	check(contracts.world_report().actors[3].trust == 0 and contracts.world_report().actors[4].trust == 0, "no automatic guilt by association")
	check(contracts.state.accepted == agreed, "trust change does not modify accepted terms")
	var rotation = Campaign.new()
	rotation.advance(14)
	check(rotation.state.offers.size() == 3 and rotation.state.offers[2].employer_id == "workshop_consortium", "fourth employer rotates into market")
	rotation.advance(14)
	check(rotation.state.offers[2].employer_id == "davion_liaison", "original liaison continues offering work")
	var old = Campaign.new(81)
	old.advance(5)
	old.set_identity("Veteranos", "Ana")
	old._change_relation("Milicia local", 2)
	old.accept_contract(0)
	old.dispatch(0, [0, 1, 2, 3], 1)
	var legacy = old.state.duplicate(true)
	legacy.version = 12
	legacy.erase("world")
	legacy["rng_state"] = str(old.rng.state)
	for contract in legacy.offers + [legacy.accepted, legacy.active.contract]: contract.erase("employer_id")
	write_fixture("user://v05_legacy.json", legacy)
	var migrated = Campaign.new()
	check(migrated.load_game("user://v05_legacy.json") == OK, "load v0.4 save")
	check(migrated.state.world.introduced_day == 5 and migrated.state.chronicle == old.state.chronicle, "world begins at loaded date without retroactive events")
	check(migrated.state.funds == old.state.funds and migrated.state.active.contract.pay == old.state.active.contract.pay and migrated.world_report().actors[1].trust == 2, "migration preserves money terms and trust")
	migrated.establish_contact("iron_watch")
	check(migrated.save_game("user://v05_roundtrip.json") == OK, "save actors and contact")
	var restored = Campaign.new()
	check(restored.load_game("user://v05_roundtrip.json") == OK and restored.state == migrated.state, "world roundtrip")
	migrated.advance(3)
	restored.advance(3)
	check(restored.state == migrated.state, "existing operation remains deterministic")
	var rng_before = restored.rng.state
	restored.world_report()
	restored.establish_contact("ember_company")
	check(restored.rng.state == rng_before, "world interactions do not consume combat randomness")
	var invalid = restored.state.duplicate(true)
	invalid["rng_state"] = str(restored.rng.state)
	invalid.world.actors[0].id = "unknown"
	write_fixture("user://v05_invalid.json", invalid)
	before = restored.state.duplicate(true)
	check(restored.load_game("user://v05_invalid.json") == ERR_INVALID_DATA and restored.state == before, "invalid actor identity rejected atomically")
	var idle = Campaign.new()
	var world_before = idle.state.world.duplicate(true)
	idle.advance(14)
	check(idle.state.world.actors[0].name == world_before.actors[0].name and idle.state.world.introduced_day == world_before.introduced_day, "world identity preserved during autonomous activity")
	var closed = Campaign.new()
	closed.state.ended = true
	before = closed.state.duplicate(true)
	closed.establish_contact("trade_league")
	check(closed.state == before, "closed campaign rejects contact")
	print("v0.5: %d checks, %d failures" % [checks, failures])
	quit(1 if failures else 0)
