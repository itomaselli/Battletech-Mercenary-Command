extends SceneTree
const C = preload("res://sim/campaign.gd")
func _initialize():
 var c = C.new(42, 3060)
 assert(c.date_text().begins_with("3060"))
 assert(c.state.mechs[0].model_id == "locust-lct-1v")
 c.accept_contract(0)
 c.dispatch(0, [0,1,2,3], 1)
 assert(c.save_game("user://v11.json") == OK)
 var b = C.new()
 assert(b.load_game("user://v11.json") == OK)
 c.advance(3)
 b.advance(3)
 assert(c.state == b.state)
 var old = c.state.duplicate(true)
 old.version = 17
 old.erase("scenario_year")
 old.rng_state = str(c.rng.state)
 for item in old.mechs + old.mech_market: item.erase("model_id")
 var file = FileAccess.open("user://v11_old.json", FileAccess.WRITE)
 file.store_string(JSON.stringify(old))
 file.close()
 assert(b.load_game("user://v11_old.json") == OK)
 assert(b.state.scenario_year == 3027)
 assert(b.state.mechs[0].model_id == "locust-lct-1v")
 print("v0.11: scenarios, stable IDs, migration and continuity passed")
 quit()
