extends SceneTree
const C = preload("res://sim/campaign.gd")
const U = preload("res://sim/universe.gd")
const L = preload("res://sim/lore.gd")
func _initialize():
 assert(U.load_data().systems.size() == 3175)
 assert(not U.system(U.galatea()).is_empty())
 assert(U.find_systems("Terra",3027).size() > 0)
 assert(L.all().size() == 15 and L.available(3027).size() == 10 and L.available(3060).size() == 15)
 var c = C.new()
 var before = c.state.duplicate(true)
 c.contact_lore("lore-blake")
 assert(c.state == before)
 c = C.new(42,3060)
 c.contact_lore("lore-blake")
 before = c.state.duplicate(true)
 c.contact_lore("lore-blake")
 assert(c.state == before)
 assert(c.save_game("user://v12.json") == OK)
 var b = C.new()
 assert(b.load_game("user://v12.json") == OK and b.state == c.state)
 print("v0.12: full import, search, scenarios, fifteen actors, contacts, save/load passed")
 quit()
